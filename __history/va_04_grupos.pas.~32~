    registroV := registroV + 1 ;
    xx:=IntToStr(registroV);
    cc := '{'+'"identificado":"'+xx+'"'+'}';
    va_05_dm.DM.RESTRequest_contadorX.Body.ClearBody;
    va_05_dm.DM.RESTRequest_contadorX.AddBody(cc,ctAPPLICATION_JSON);
    va_05_dm.DM.RESTRequest_contadorX.Execute;

end;



