procedure Tva_cat_CAD.SelecionaIcone(img: TImage);              // UMA PROCEDURE . trata a imagem   // NESTE PROGRAMA privada
begin
    icone_selecionado  := img.Bitmap;                          // variavel criada PRIVATE   icone_selecionado: TBitmap;
    indice_selecionado := TListBoxItem(img.Parent).Index;    //  indice_selecionado: Integer; VARIAVEL  private
    img_selecao.Parent := img.Parent;
//  ShowMessage(IntToStr(id_cat)+' = id_cat que é o ID_CATEGORIA');
//  ShowMessage(edt_descricao.Text+ ' = é o edit dentro do formulario ');
//  ShowMessage((intToStr(indice_selecionado))+ ' = capturado o indice da figura - INDICE_ICONE');
    id_img := intToStr(indice_selecionado);  // Quando voce escolhe um icone, ele é atualizado aqui .
end;


procedure Tva_cat_CAD.confirma;
var
   cc : String ;
begin
    va_05_dm.DM.RESTRequest_categoria.Method := TRESTRequestMethod.rmPATCH;
    va_05_dm.DM.RESTRequest_categoria.Params.ParameterByName('id').Value := id;
    cc := '{'+'"status":"n"'+'}';
    va_05_dm.DM.RESTRequest_categoria.Body.ClearBody;
    va_05_dm.DM.RESTRequest_categoria.AddBody(cc,ctAPPLICATION_JSON);
    va_05_dm.DM.RESTRequest_categoria.Execute;
end;

procedure Tva_cat_CAD.grava;
var
   cc : String ;
begin
    id:= IntToStr(StrToInt(id)+1);
    va_05_dm.DM.RESTClient_contador.BaseURL :='https://vaquinha-8e06e-default-rtdb.firebaseio.com/tab_contador/cod_contador/0.json?auth=AIzaSyBVLql1yRfz_h9yenkJYdH8VJl-JlPcnCI';
    va_05_dm.DM.RESTRequest_contador.Method := TRESTRequestMethod.rmPATCH;
    cc := '{'+'"categoria":"'+id+'"'+'}';
    va_05_dm.DM.RESTRequest_contador.Body.ClearBody;
    va_05_dm.DM.RESTRequest_contador.AddBody(cc,ctAPPLICATION_JSON);
    va_05_dm.DM.RESTRequest_contador.Execute;
end;



procedure Tva_cat_CAD.contador;
var
  jsonArray    : TJSONArray   ;
  jsonString   : string       ;
  jsonObject   : TJSONObject  ;
  jsonPair     : TJSONPair    ;
  jsonValue    : TJSONValue   ;
  i,j          : Integer      ;
begin

  va_05_dm.DM.RESTRequest_contador.Execute;
  jsonString := va_05_dm.DM.RESTRequest_contador.Response.Content ;             // o conteudo está dentro de um ARRAY

   if controlador = 2 then   jsonString := '['+jsonString+']';                   // lá no RESTRequest no .json gera um arquivo ARRAY
   if controlador <> 2 then controlador:=2;                                      // para resolver gerei um variavel public controlador para criar um ARRAY

 ShowMessage('dentro do json  '+jsonString);
  jsonArray := TJSONObject.ParseJSONValue(jsonString) as TJSONArray;
 ShowMessage('2');

  try                                                                            // Verificar se o array JSON foi criado com sucesso
    if Assigned(jsonArray) then
    begin
      for i := 0 to jsonArray.Count - 1 do                                       // este ARQUIVO  só tem 1 registro SEMPRE .... // Iterar sobre cada objeto no array
       begin
        jsonObject := jsonArray.Items[i] as TJSONObject;                        // Obter o objeto JSON atual

        if Assigned(jsonObject) then
        begin
          jsonPair := jsonObject.Get('categoria');                              // Obter o par chave-valor "dados"

          if Assigned(jsonPair) then
          begin
            jsonValue := jsonPair.JsonValue;                                    // Obter o valor associado à chave "dados"

            if Assigned(jsonValue) then
            begin
             id := jsonvalue.ToString;
             id := Trim(id);
             id := id.Replace('"',''); // retira as " aspas do campo ID

            end;
          end;
        end;
      end;
    end;
  finally
    // Liberar o array JSON
    jsonArray.Free;
  end;
end;

end.
