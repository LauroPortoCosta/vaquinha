procedure Tva_debitos.AddCategoria(id, icone : integer; descricao: string);   // 2 //
var  //------------ ADICIONA CATEGORA .... no modo RAIS kkkkk
    item    : TListBoxItem;
    rect    : TRectangle;
    lbl     : TLabel;
    img_box : TImage;
begin

//------------------------------------------------------------------------------
    item := TListBoxItem.Create(lbCategoria);
    item.HitTest    := false;
    item.Selectable := True ;
    item.Height     := 60  ;
    item.Width      := 130 ;
    item.Text       := ' ';
    item.Tag        := id; // o que está dentro da variável é o valor do icone
    item.Align      := TAlignLayout.Client;
//------------------------------------------------------------------------------
    rect            := TRectangle.Create(item);
    rect.Cursor     := crHandPoint;
    rect.HitTest    := false;
    rect.Fill.Color := $FFE2E2E2;
    rect.Align      := TAlignLayout.Client;
    rect.Margins.Top    := 8;
    rect.Margins.Left   := 8;
    rect.Margins.Right  := 8;
    rect.Margins.Bottom := 8;
    rect.XRadius        := 10;
    rect.YRadius        := 10;
    rect.Stroke.Kind    := TBrushKind.None;

//------------------------------------------------------------------------------
    img_box         := TImage.Create(rect);
    img_box.Height  := 50  ;
    img_box.Width   := 50 ;

       case icone of
            0:  img_box := ImageA1;
            1:  img_box := ImageA2;
            2:  img_box := ImageA3;
            3:  img_box := ImageA4;
            4:  img_box := ImageB1;
            5:  img_box := ImageB2;
            6:  img_box := ImageB3;
            7:  img_box := ImageB4;
            8:  img_box := ImageC1;
            9:  img_box := ImageC2;
            10: img_box := ImageC3;
            11: img_box := ImageC4;
            12: img_box := ImageD1;
            13: img_box := ImageD2;
            14: img_box := ImageD3;
            15: img_box := ImageD4;
            16: img_box := img_selecao;

       end;
    img_box.Align   := TAlignLayout.Center;
    img_box.HitTest := false;
//------------------------------------------------------------------------------
    lbl                 := TLabel.Create(rect);
    lbl.HitTest         := false;
    lbl.Align           := TAlignLayout.Bottom;
    lbl.Text            := descricao;
    lbl.TextSettings.HorzAlign := TTextAlign.Center;
    lbl.TextSettings.VertAlign := TTextAlign.Center;
    lbl.StyledSettings         := lbl.StyledSettings - [TStyledSetting.Size, TStyledSetting.FontColor, TStyledSetting.Style, TStyledSetting.Other];
    lbl.Font.Size              := 13;
    lbl.FontColor := $FF3A3A3A;
//------------------------------------------------------------------------------
    rect.AddObject(lbl);
    rect.AddObject(img_box);
    item.AddObject(rect);
    lbCategoria.AddObject(item);

end;


