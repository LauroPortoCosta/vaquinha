                     TMsgDlgType.mtConfirmation,
                     [TMsgDlgBtn.mbYes, TMsgDlgBtn.mbNo],
                     TMsgDlgBtn.mbNo,
                     0,

     procedure(const AResult: TModalResult)
     var
        erro: string;
     begin


        if AResult = mrYes then
        begin


            try
                cat := 'TCategoria.Create(dm.conn)';

                begin
                    showmessage(erro);
                    exit;
                end;

                FormShow(Sender);
                close;

            finally
               // cat.DisposeOf;
            end;


        end;


     end     );



end;

