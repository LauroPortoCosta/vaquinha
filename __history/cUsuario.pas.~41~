unit cUsuario;
// mobile 18
interface

uses FireDAC.Comp.Client, FireDAC.DApt, System.SysUtils, FMX.Graphics,
     FireDAC.Comp.DataSet, REST.Types, System.JSON, FMX.Memo.Types,
     FMX.ScrollBox, FMX.Memo,  System.Variants;

type
    TUsuario = class
    private
        Fconn: TFDConnection;
        FIND_LOGIN    : string;
        FEMAIL        : string;
        FSENHA        : string;
        FNOME         : string;
        FID_USUARIO   : Integer;
        FID_GRUPO     : Integer;
        FID_CATEGORIA : Integer;
        FFOTO         : TBitmap;
        controlador   : integer;
        FID           : Integer;
    procedure contador;
    procedure grava;
    public
        constructor Create(conn: TFDConnection);

        property ID           : Integer read FID           write FID ;
        property ID_USUARIO   : Integer read FID_USUARIO   write FID_USUARIO;
        property ID_GRUPO     : Integer read FID_GRUPO     write FID_GRUPO;
        property ID_CATEGORIA : Integer read FID_CATEGORIA write FID_CATEGORIA;
        property NOME         : string  read FNOME         write FNOME;
        property EMAIL        : string  read FEMAIL        write FEMAIL;
        property SENHA        : string  read FSENHA        write FSENHA;
        property IND_LOGIN    : string  read FIND_LOGIN    write FIND_LOGIN;
        property FOTO         : TBitmap read FFOTO         write FFOTO;

        function Busca_ID(out erro: string): boolean;
        function ListarUsuario(out erro: string): TFDQuery;
        function Inserir(out erro: string): Boolean;
        function Alterar(out erro: string): Boolean;
        function Excluir(out erro: string): Boolean;
        function ValidarLogin(out erro: string): boolean;
        function Logout(out erro: string): boolean;

end;

implementation

{ TCategoria }

uses va_05_dm;


constructor TUsuario.Create(conn: TFDConnection);
begin
    Fconn := conn;
end;



function TUsuario.Inserir(out erro: string): Boolean;
var
    xx,cc,yy : string;
begin
     yy:='S';

    // Validacoes...
    if NOME = '' then
    begin
        yy:='N';
        erro := 'Informe o nome do usuário';
        Result := false;
        exit;
    end;

    if EMAIL = '' then
    begin
        yy:='N';
        erro := 'Informe o email do usuário';
        Result := false;
        exit;
    end;

    if SENHA = '' then
    begin
        yy:='N';
        erro := 'Informe a senha do usuário';
        Result := false;
        exit;
    end;


    if yy = 'S' then
    begin
       contador;              // Recebe o último id
       grava;                // Grava na nuvem o último id+1
       xx:= IntToStr(ID);   // grava o registro com o ID
       va_05_dm.DM.RESTRequest_usuarioT.Params.ParameterByName('ID').Value := xx;
       va_05_dm.DM.RESTRequest_usuarioT.Params.Items[0].name  := 'param';                                   // item = param
       cc:= '{"id":"'+xx+'","nome":"'+NOME+'","senha":"'+SENHA+'","email":"'+EMAIL+'","status":"s","id_grupo":"0","id_categoria":"0"}';
       va_05_dm.DM.RESTRequest_usuarioT.Params.Items[0].value :=cc;                                         // colocado dentro do RESTRequest1 o conteudo de cc
       va_05_dm.DM.RESTRequest_usuarioT.Params.Items[0].ContentType := ctAPPLICATION_JSON;                  // ct application
       va_05_dm.DM.RESTRequest_usuarioT.Params.Items[0].Kind := TRESTRequestParameterKind.pkGETorPOST;      // recebe um pk GET ou POST ( se não existir atualize )
       va_05_dm.DM.RESTRequest_usuarioT.Execute;
       Result := true;
       exit;
    end;
end;




function TUsuario.Alterar(out erro: string): Boolean;
begin
    // Validacoes...
    if NOME = '' then
    begin
        erro := 'Informe o nome do usuário';
        Result := false;
        exit;
    end;

    if EMAIL = '' then
    begin
        erro := 'Informe o email do usuário';
        Result := false;
        exit;
    end;

    if SENHA = '' then
    begin
        erro := 'Informe a senha do usuário';
        Result := false;
        exit;
    end;


end;


function TUsuario.Excluir(out erro: string): Boolean;
begin

    if NOME = '' then
    begin
        erro := 'Informe o nome do usuário';
        Result := false;
        exit;
    end;

    if EMAIL = '' then
    begin
        erro := 'Informe o email do usuário';
        Result := false;
        exit;
    end;

    if SENHA = '' then
    begin
        erro := 'Informe a senha do usuário';
        Result := false;
        exit;
    end;

    try

       va_05_dm.DM.RESTRequest_usuario.Execute;
       if va_05_dm.DM.FDMemTable_usuario.Locate( 'email', VarArrayOf([EMAIL]),[]) then
       begin
          Result := false;
       erro := 'Usuário já cadastrado';
       end;

    except on ex:exception do
       begin
          Result := False;
          erro := 'Erro ao excluir usuário: ' + ex.Message;
       end;
    end;

end;


function TUsuario.ListarUsuario(out erro: string): TFDQuery;
var
  Item: TFDLocalSQLDataSet;
begin
     va_05_dm.DM.FDLocalSQL_usuario.Active := True;                             // cria do vez
     va_05_dm.DM.FDLocalSQL_usuario.DataSets.Clear;                             // limpa o LOCAL SQL
     Item         := va_05_dm.DM.FDLocalSQL_usuario.DataSets.Add;               // eu já tenho um LOCAL criado e configurado lá no DM
     Item.Name    := 'usuario';                                                 // dei um nome para o item ... usuario é sugestivo
     Item.DataSet := va_05_dm.DM.FDMemTable_usuario;                            // joguei minha tabela (MEMORIA) dentro do item
     va_05_dm.DM.RESTRequest_usuario.Execute;
     va_05_dm.DM.FDQuery_usuario.Connection := va_05_dm.DM.conn;                // Aqui eu já tenho uma QUERY
     va_05_dm.DM.FDQuery_usuario.SQL.Text   :=  'SELECT * FROM usuario WHERE status = ''s'' ' ;
     va_05_dm.DM.FDQuery_usuario.Open;

    try
        with va_05_dm.DM.FDQuery_usuario do
        begin
            Active := false;
            sql.Clear;
            sql.Add('SELECT * FROM usuario');
            SQL.Add('WHERE 1 = 1');


            if EMAIL <> '' then
            begin
                SQL.Add('AND EMAIL = :EMAIL');
                ParamByName('EMAIL').Value := EMAIL;
            end;

            if SENHA <> '' then
            begin
                SQL.Add('AND SENHA = :SENHA');
                ParamByName('SENHA').Value := SENHA;
            end;

            Active := true;
        end;

        Result := va_05_dm.DM.FDQuery_usuario;
        erro := '';

    except on ex:exception do
    begin
        Result := nil;
        erro := 'Erro ao consultar usuários: ' + ex.Message;
    end;
   end;
end;



function TUsuario.ValidarLogin(out erro: string): boolean;
 begin

    // Validacoes...

    if EMAIL = '' then
    begin
        erro := 'Informe o email do usuário';
        Result := false;
        exit;
    end;

    if SENHA = '' then
    begin
        erro := 'Informe a senha do usuário';
        Result := false;
        exit;
    end;

      va_05_dm.DM.RESTRequest_usuario.Execute;
   if va_05_dm.DM.FDMemTable_usuario.Locate( 'email;senha', VarArrayOf([EMAIL,SENHA]),[]) then
       begin
         NOME         := va_05_dm.DM.FDMemTable_usuario.FieldByName('nome').AsString;
         ID_USUARIO   := va_05_dm.DM.FDMemTable_usuario.FieldByName('id').AsInteger;
         Result       := true;
       end;
 end;



function TUsuario.Logout(out erro: string): boolean;
var
  Item: TFDLocalSQLDataSet;
begin
     va_05_dm.DM.conn.Connected := True;
     va_05_dm.DM.FDLocalSQL_usuario.Active := True;
     va_05_dm.DM.FDLocalSQL_usuario.DataSets.Clear;
     Item         := va_05_dm.DM.FDLocalSQL_usuario.DataSets.Add;
     Item.Name    := 'usuario';
     Item.DataSet := va_05_dm.DM.FDMemTable_usuario;
//--------------------------------------------------------------------
     va_05_dm.DM.FDQuery_usuario.Connection := va_05_dm.DM.conn;
     va_05_dm.DM.FDQuery_usuario.SQL.Text   :=  'SELECT * FROM usuario WHERE status=''s''';
     va_05_dm.DM.FDQuery_usuario.Open;
end;



procedure TUsuario.grava;
var
    cc,xx : String ;
begin
    ID:= ID+1;
    xx:= IntToStr(ID);
    cc := '{'+'"usuario":"'+xx+'"'+'}';
    va_05_dm.DM.RESTRequest_contadorX.Body.ClearBody;
    va_05_dm.DM.RESTRequest_contadorX.AddBody(cc,ctAPPLICATION_JSON);
    va_05_dm.DM.RESTRequest_contadorX.Execute;
end;



procedure TUsuario.contador;
begin
    va_05_dm.DM.RESTRequest_contador_G.Execute;
 if va_05_dm.DM.FDMemTable_contador.Locate('id;status',VarArrayOf(['0', 's']), []) then
    begin
     ID := va_05_dm.DM.FDMemTable_contador.FieldByName('usuario').AsInteger;
    end;
end;




function TUsuario.Busca_ID(out erro: string): boolean;
 begin
       va_05_dm.DM.RESTRequest_usuario.Execute;
   if va_05_dm.DM.FDMemTable_usuario.Locate( 'id', VarArrayOf([IntToStr(ID_USUARIO)]),[]) then
       begin

         NOME         := va_05_dm.DM.FDMemTable_usuario.FieldByName('nome').AsString;
         ID_USUARIO   := va_05_dm.DM.FDMemTable_usuario.FieldByName('id').AsInteger;
         ID_GRUPO   := va_05_dm.DM.FDMemTable_usuario.FieldByName('id_grupo').AsInteger;
         ID_CATEGORIA   := va_05_dm.DM.FDMemTable_usuario.FieldByName('id_categoria').AsInteger;
         Result       := true;
       end;
 end;

end.
