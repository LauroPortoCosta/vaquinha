procedure Tva_debitos.SelecionarCategoria(item: TListBoxItem);
var
  x         : integer;
  item_loop : TListBoxItem;
  rect      : TRectangle;
  lbl       : TLabel;
begin
    for x := 0 to lbCategoria.Items.Count - 1 do
    begin
        item_loop := lbCategoria.ItemByIndex(x);
//      ShowMessage('linha 301 - SelecionarCategoria tem   :  '+ intToStr(lbCategoria.Items.Count) );
    end;
    lbCategoria.Tag := item.Tag;
end;



procedure Tva_debitos.AddCategoria(id_categoria: integer; descricao: string);   // 2 //
var
    item: TListBoxItem;
    rect: TRectangle;
    lbl: TLabel;
    img_box : TImage;
begin
//------------------------------------------------------------------------------
    item := TListBoxItem.Create(lbCategoria);
    item.Selectable := false ;
    item.Height     := 60  ;
    item.Width      := 130 ;
    item.Text       := ' ';
    item.Tag        := id_categoria; // o que está dentro da variável é o valor do icone
    item.Align      := TAlignLayout.Client;
//------------------------------------------------------------------------------
    rect            := TRectangle.Create(item);
    rect.Cursor     := crHandPoint;
    rect.HitTest    := false;
    rect.Fill.Color := $FFE2E2E2;
    rect.Align      := TAlignLayout.Client;
    rect.Margins.Top    := 8;
    rect.Margins.Left   := 8;
    rect.Margins.Right  := 8;
    rect.Margins.Bottom := 8;
    rect.XRadius        := 6;
    rect.YRadius        := 6;
    rect.Stroke.Kind    := TBrushKind.None;
//------------------------------------------------------------------------------
    img_box         := TImage.Create(rect);
    img_box.Height  := 50  ;
    img_box.Width   := 50 ;
 Showmessage(IntToStr(id_categoria)+' valor que esta no id ' +IntToStr(item.tag));

       case id_categoria of
            0:
            img_box := ImageA1;
            1:
            img_box := ImageA2;
            2:
            img_box := ImageA3;
            3:
            img_box := ImageA4;
            4:
            img_box := ImageB1;
            5:
            img_box := ImageB2;
            6:
            img_box := ImageB3;
            7:
            img_box := ImageB4;
            8:
            img_box := ImageC1;
            9:
            img_box := ImageC2;
            10:
            img_box := ImageC3;
            11:
            img_box := ImageC4;
            12:
            img_box := ImageD1;
            13:
            img_box := ImageD2;
            14:
            img_box := ImageD3;
            15:
            img_box := ImageD4;
            16:
            img_box := img_selecao;

       end;
    img_box.Align   := TAlignLayout.Center;
//------------------------------------------------------------------------------
    lbl                 := TLabel.Create(rect);
    lbl.Align           := TAlignLayout.Bottom;
    lbl.Text            := descricao;
    lbl.TextSettings.HorzAlign := TTextAlign.Center;
    lbl.TextSettings.VertAlign := TTextAlign.Center;
    lbl.StyledSettings         := lbl.StyledSettings - [TStyledSetting.Size, TStyledSetting.FontColor, TStyledSetting.Style, TStyledSetting.Other];
    lbl.Font.Size              := 13;
    lbl.FontColor := $FF3A3A3A;
//------------------------------------------------------------------------------
    rect.AddObject(lbl);
    rect.AddObject(img_box);
    item.AddObject(rect);
    lbCategoria.AddObject(item);

end;



