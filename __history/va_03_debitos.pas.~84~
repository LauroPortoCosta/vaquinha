procedure Tva_debitos.CarregarDados;
var
  t : TThread;
  x : string;
begin
    lbCategoria.Items.Clear;
    t := TThread.CreateAnonymousThread(procedure
    begin
        va_05_dm.DM.RESTRequest_categoria.Execute;
        with va_05_dm.DM.FDMemTable_categoriadescricao do
        begin
            TThread.Synchronize(TThread.CurrentThread, procedure
            begin
               descricao:= va_05_dm.DM.FDMemTable_categoriadescricao.ToString;
               ListarCategorias;
            end);
        end;

        // Listar as categorias...
    end);
    t.OnTerminate := ThreadDadosTerminate;
    t.Start;
end;



procedure Tva_debitos.ListarCategorias;                                         // 1 //
begin
         va_05_dm.DM.RESTRequest1.Execute;
         va_05_dm.DM.FDMemTable1.First;
    with va_05_dm.DM.FDMemTable1   do
    begin
        while NOT Eof do
        begin
            TThread.Synchronize(TThread.CurrentThread, procedure
            begin
              if va_05_dm.DM.FDMemTable1status.Value = 's'  then
                 begin
                   descricao := va_05_dm.DM.FDMemTable1descricao.Value;
                   AddCategoria(fieldbyname('icone').asinteger, fieldbyname('descricao').asstring);
                 end;
            end);
            Next;
        end;
    end;
    if lbCategoria.Items.Count > 0 then
        TThread.Synchronize(TThread.CurrentThread, procedure
            begin
                SelecionarCategoria(lbCategoria.ItemByIndex(0));
            end)
end;


