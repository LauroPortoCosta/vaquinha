procedure Tva_08_grupo_c.confirma;
var
   cc : String ;
begin
    va_05_dm.DM.RESTRequest2_grupo.Method := TRESTRequestMethod.rmPATCH;
    va_05_dm.DM.RESTRequest2_grupo.Params.ParameterByName('id').Value :=id;
    cc := '{'+'"status":"n"'+'}';
    va_05_dm.DM.RESTRequest2_grupo.Body.ClearBody;
    va_05_dm.DM.RESTRequest2_grupo.AddBody(cc,ctAPPLICATION_JSON);
    va_05_dm.DM.RESTRequest2_grupo.Execute;
end;
