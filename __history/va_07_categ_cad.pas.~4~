procedure Tva_cat_CAD.FormShow(Sender: TObject);
var
      erro  : string;          // objetivo da variavel é quardar informaçoes de erro, que vai ser usada pelo sistema
      item  : TListBoxItem;    // servirá para armazenar o número da minha listbox
      img   : TImage;
begin
    if modo = 'I' then                    // estou no On Show , ele pergunta de é uma inclusao ... se nao for ELSE vai ser alteracao
    begin
         Rectangle1.Visible  := false;    // ativando o retangulo de delecao
         edt_descricao.Text  := ' ';      // se for inclusao o campo edit fica em branco // edt_descricao (Tedit) é um campo do FORMULARIO e classificado como texto .Text
         SelecionaIcone(Image1);          // e a imagem vai ser a sempre a primeira IMAGEM 1
                                          //  procedure TFrmCategoriasCad.SelecionaIcone(img: TImage); //  SelecionaIcone(Image1); ele pega qualquer imagem que for apontado  //Image1 //Image2 //Image3
    end
    else
    begin
        try
            rectangle1.Visible := true;                                   //  FICA ASSIM    | ATIVANDO o retangulo com a imagem de delecao   // retangulo é um componete do PALLET que foi colocado no formulario
//          edt_descricao.Text := qry.FieldByName('DESCRICAO').AsString; // meu edit1.text recebe a DESCRICAO que a qry a cima selecionou
           item := lb_icone.ItemByIndex(0);                             // item:TListBoxItem; variável criada logo a cima, //lb_icone = nome dado a ListBox no formulário // ItemByIndex = busca no item o indice ( faz parte do comando )
           // item            : variavel tipo TImage criada nesta função
           // lb_icone        : list Box criada com nome de lb_icone
           // ItemByIndex     : função do DELPHI que busca o indice no item
            img_selecao.Parent := item; // img_selecao = é a imagem criada no formulario (list Box)  com o fundo cinza // e o Parent é a dependencia que ele terá no quadro da listbox  // recebe o ITEM , tipo ( 0= primeiro quadro 1=segundo quadro etc
            SelecionaIcone(img);       // procedure TForm7.SelecionaIcone(img: TImage); e após o item anterior que selecionou a imagem que clicamos na lista
         //-----------------------------------------------------------------------------
         // CORRIGIU O BUG QUE ESTA DANDO QUANDO SALVAVA, E SO GRAVAVA O ICONE ANTERIOR
         // SENDO ASSIM AQUIE FICOU DA SEGUINTE FORMA
         // O INDECE SEMPRE COMEÇA COM ZERO
         // vai passar para o sistema o numero do indice que inicia 0,1,2,3 para a imagem ( 0+1=1 ) imagem1 image2 ...
         // img                  : e uma variável do timo Timage
         // FrmCategoriaCad      : é este formulario
         // FindComponete        : é uma funçao que busca o componente Image
         // image                : parametro passado
         // item                 : variavel tipo TImage criada nesta função //item := lb_icone.ItemByIndex(qry.FieldByName('INDICE_ICONE').AsInteger); // item:TListBoxItem; variável criada logo a cima, //lb_icone = nome dado a ListBox no formulário // ItemByIndex = busca no item o indice ( faz parte do comando )
         // .index               : o valor do indice daquele item
         // +1                   : como o componete começa com zero será solicitado mais um para identificar a figura correta
         // ToString             : to  para // String  espressão
         // as TImage            : como imagem

       finally


        end;

    end;




end;

procedure Tva_cat_CAD.Image1Click(Sender: TObject);
begin
    SelecionaIcone(TImage(Sender));

end;

