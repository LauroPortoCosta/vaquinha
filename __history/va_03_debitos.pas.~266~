procedure Tva_debitos.Inclusao;
var
  u: TUsuario;
  erro: string;
 begin


     lbCategoria.Clear;
     carrega;


            va_abertura.ALTERACAO_P := 'i' ;
            u            := TUsuario.Create(va_05_dm.DM.conn) ;
            u.ID_USUARIO := StrToInt(va_abertura.ID_PUBLICO)  ;
            id_usuario   := va_abertura.ID_PUBLICO            ;
            grupo_u      := u.ID_GRUPO     ;
            categoria_u  := u.ID_CATEGORIA ;

              if NOT u.Busca_ID(erro) then
                    begin
                       exit;
                    end;

            grupo_u            :=  u.ID_GRUPO     ;
            categoria_u        :=  u.ID_CATEGORIA ;
            PosicionaCategoria ;
            ListarCategorias   ;
            carrega            ;

            grupo_u            := u.ID_GRUPO      ;
            categoria_u        := u.ID_CATEGORIA  ;

 end;
