procedure Tva_debitos.resolve;
var
 o_que_vejo : integer ;
 cc  , t    : string  ;
begin

   // CONSULTA

        va_05_dm.DM.RESTRequest_vai.Execute;

 if    va_05_dm.DM.FDMemTable_vai.Locate('id;status',VarArrayOf(['0', 's']), []) then
       begin
           o_que_vejo := va_05_dm.DM.FDMemTable_contador.FieldByName('lancamento').AsInteger;
           t:= va_05_dm.DM.RESTResponse_vai.Content;
           ShowMessage(t);
       end;

   // GRAVA

      if o_que_vejo < NUMERADOR then
         begin
             va_05_dm.DM.RESTRequest_volta.Params.ParameterByName('x').Value := '0';
             va_05_dm.DM.RESTRequest_volta.Params.Items[0].name  := 'param';                                   // item = param
             cc := '{'+'"lancamento":"'+IntToStr(NUMERADOR)+'"'+'}';
             va_05_dm.DM.RESTRequest_volta.Params.Items[0].value :=cc;                                         // colocado dentro do RESTRequest1 o conteudo de cc
             va_05_dm.DM.RESTRequest_volta.Params.Items[0].ContentType := ctAPPLICATION_JSON;                  // ct application
             va_05_dm.DM.RESTRequest_volta.Params.Items[0].Kind := TRESTRequestParameterKind.pkGETorPOST;      // recebe um pk GET ou POST ( se não existir atualize )
             va_05_dm.DM.RESTRequest_volta.Execute;
         end;

   ShowMessage('   Numerador ' +IntToStr(NUMERADOR)+'   o que está dentro do arquivo '+IntToStr(o_que_vejo));

end;

